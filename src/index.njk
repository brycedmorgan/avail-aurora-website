    -webkit-text-fill-color: transparent;
    background-size: 200% 200%;
    animation: aurora-text 4s ease-in-out infinite;
}

@keyframes aurora-text {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
}

